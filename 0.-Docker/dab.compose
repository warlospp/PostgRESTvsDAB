docker run -d ^
  --name dab-datarest ^
  --network bridge ^
  -p 5000:5000 ^
  -v "D:\DockerVolumes\dab\config\dab-config.json:/App/dab-config.json:ro" ^
  mcr.microsoft.com/azure-databases/data-api-builder:2.0.11
  
  docker network connect api-network dab-datarest
  
  docker inspect dab-datarest --format "{{json .NetworkSettings.Networks}}"