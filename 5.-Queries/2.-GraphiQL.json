###########
# GRAPHQL #
###########

# Acceder GraphiQL
#http://localhost:5000/graphql

# Filtro y Select
query {
  clients(
    filter: {
      first_name: {
        eq: "John"
      }
    }
  ) {
    items {
      client_id
      identification_number
      first_name
      last_name
      email
      phone
    }
  }
}

# Contiene
query {
  clients(
    filter: {
      first_name: {
        contains: "oh"
      }
    }
  ) {
    items {
      client_id
      first_name
      last_name
    }
  }
}

# Muestreo
query {
  clients(first: 2) {
    items {
      client_id
      first_name
      last_name
    }
  }
}

#Paginación
query { clients(first: 5) { items { client_id first_name last_name email } endCursor hasNextPage } }
query { clients(first: 5, after: "W3siRW50aXR5TmFtZSI6ImNsaWVudHMiLCJGaWVsZE5hbWUiOiJjbGllbnRfaWQiLCJGaWVsZFZhbHVlIjo1LCJEaXJlY3Rpb24iOjB9XQ==") { items { client_id first_name last_name email } endCursor hasNextPage } }
