{
  "$schema": "https://github.com/Azure/data-api-builder/releases/latest/download/dab.draft.schema.json",

  "data-source": {
    "database-type": "mssql",
    "connection-string": "Server=sqlserver-container,1433;Database=bdd_demo;User Id=demo_readonly_login;Password=Admin.123;TrustServerCertificate=True;Encrypt=True;"
  },

  "runtime": {
    "rest": {
      "enabled": true,
      "path": "/api"
    },

    "graphql": {
      "enabled": false
    },

    "host": {
      "mode": "development"
    }
  },

  "entities": {

    "Clients": {
      "source": {
        "object": "dbo.Clients",
        "type": "table"
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            "read"
          ]
        }
      ]
    },

    "IdentificationTypes": {
      "source": {
        "object": "dbo.IdentificationTypes",
        "type": "table"
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            "read"
          ]
        }
      ]
    },

    "ClientsWithIdentification": {
      "source": {
        "object": "dbo.vwClientsWithIdentification",
        "type": "view"
      },
      "permissions": [
        {
          "role": "anonymous",
          "actions": [
            "read"
          ]
        }
      ]
    }

  }
}
